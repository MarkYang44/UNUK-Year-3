{"id":"sh/107mpwza","kind":"textbox","name":"Title 1","position":{"left":88,"top":38.33,"width":1104,"height":139.17},"text":"Task 2 - P2: Build and test pipeline","style":{"fontSize":58.67,"typeface":"Aptos Display","color":"#000000","alignment":"left"}},
{"id":"sh/0zylgry5","kind":"textbox","name":"block-1-label","position":{"left":88,"top":190,"width":1104,"height":36},"text":"Weeks 3-5 | Dev lead + Test lead","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/n2p4r6hg","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"Version application code, pipeline files and deployment scripts. Add peer review and required checks; integrate small changes daily. Proposed pilot tools: Git and GitHub Actions.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/21g3i1gv","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"Executable path","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/p4rmtgzm","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Commit -> build -> unit tests -> integration tests against a test database -> acceptance checks -> versioned artifact -> staging. Failed checks block release and return to the change owner.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/o3y5kby1","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"Acceptance and documents","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/b694v6hs","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"The pilot critical journey passes automatically in staging. Test all three applications when shared schemas change. Publish pipeline setup, test ownership and a release checklist; retain exploratory acceptance testing.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/a50nmlg7","kind":"textbox","name":"page-number","position":{"left":1165,"top":693,"width":38,"height":22},"text":"10","style":{"fontSize":16,"typeface":"Aptos","color":"#7F7F7F","alignment":"left"},"geometry":"rect","lineWidth":0}
