{"id":"sh/3e5o76ds","kind":"textbox","name":"Title 1","position":{"left":88,"top":38.33,"width":1104,"height":139.17},"text":"Task 2 - Resources and rollout gates","style":{"fontSize":58.67,"typeface":"Aptos Display","color":"#000000","alignment":"left"}},
{"id":"sh/2dwny1c7","kind":"textbox","name":"block-1-label","position":{"left":88,"top":190,"width":1104,"height":36},"text":"Proposed allocation | CEO + department heads","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/1cn65wvm","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"Pilot: two developers, one tester and one Ops engineer at 50% time; transformation lead at 20%. Sales product owner joins weekly prioritization. Confirm capacity and cloud budget in week 1.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/gbe5wru1","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"Week 6 pilot gate | Ops + Test + Sales","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/fa5o3mdg","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Required checks pass; all-app schema tests pass; two staging release/rollback drills succeed; runbook and alert ownership are agreed. Then approve the first small production release.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/epwnuhwv","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"Weeks 7-12 | Transformation lead","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ton61cva","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"Collect two weeks of live pilot evidence, then onboard the second team in weeks 9-10 and the third in weeks 11-12 if gates pass. If reliability worsens, defer rollout and fix the constraint.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/sne5sre5","kind":"textbox","name":"page-number","position":{"left":1165,"top":693,"width":38,"height":22},"text":"13","style":{"fontSize":16,"typeface":"Aptos","color":"#7F7F7F","alignment":"left"},"geometry":"rect","lineWidth":0}
