{"id":"sh/yl8ve9gn","kind":"textbox","name":"Title 1","position":{"left":88,"top":38.33,"width":1104,"height":139.17},"text":"Task 1 - Testing and release queues","style":{"fontSize":58.67,"typeface":"Aptos Display","color":"#000000","alignment":"left"}},
{"id":"sh/zm1c7ex8","kind":"textbox","name":"block-1-label","position":{"left":88,"top":190,"width":1104,"height":36},"text":"C3: assumptions","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/cjqdcjyh","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"A6: the Test team has limited capacity and repeated regression work. A7: deployment depends on manual steps and person-specific knowledge.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/dkzu5of2","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"Implications","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/qx8va9gb","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Work waits between teams; large release batches increase rework and recovery effort. Faster development alone can enlarge the test queue.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/rihc3exw","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"Response and trade-off","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/wfud83yl","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"Measure queue time first. Automate critical regression checks, retain exploratory acceptance tests, and limit work in progress. Give the pilot squad joint responsibility for release readiness.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/xg3eh8f6","kind":"textbox","name":"page-number","position":{"left":1165,"top":693,"width":38,"height":22},"text":"07","style":{"fontSize":16,"typeface":"Aptos","color":"#7F7F7F","alignment":"left"},"geometry":"rect","lineWidth":0}
