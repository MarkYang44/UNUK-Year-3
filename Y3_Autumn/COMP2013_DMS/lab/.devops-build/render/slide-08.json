{"id":"sh/gjepg3yp","kind":"textbox","name":"Title 1","position":{"left":88,"top":38.33,"width":1104,"height":139.17},"text":"Task 2 - Objectives and approach","style":{"fontSize":58.67,"typeface":"Aptos Display","color":"#000000","alignment":"left"}},
{"id":"sh/hknqpofa","kind":"textbox","name":"block-1-label","position":{"left":88,"top":190,"width":1104,"height":36},"text":"First Way: flow across the whole system","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/25g7itgv","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"Make work visible, limit work in progress, reduce batch sizes and handoffs, then improve the measured constraint.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/36p8ryxg","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"Proposed 12-week outcomes","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/47ypk3y1","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Pilot: halve median commit-to-production time; deploy at least weekly; do not worsen the change failure rate; demonstrate rollback within 10 minutes. Baselines are unknown until weeks 1-2.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/p87qt8fm","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"Pilot before scaling","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/i9c769gr","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"Select one application and one critical user journey. Continue normal development; reserve pilot capacity rather than stop the whole company. Broader rollout depends on the pilot evidence.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/jalofehc","kind":"textbox","name":"page-number","position":{"left":1165,"top":693,"width":38,"height":22},"text":"08","style":{"fontSize":16,"typeface":"Aptos","color":"#7F7F7F","alignment":"left"},"geometry":"rect","lineWidth":0}
