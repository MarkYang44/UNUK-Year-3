{"id":"sh/hgvml4zq","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"About 100 people at one site; three development teams of 10-15 people. Three web applications share a common database.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/gfmlczyl","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"Current delivery process","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/fed4juh0","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Sales gathers requirements; teams use their own processes and tools. Development performs functional tests; Test performs manual integration and acceptance tests; Operations deploys to Google Cloud.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ud43apgf","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"Communication","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/tcbmhkzu","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"Informal email is the primary channel. The business domain and current delivery performance are not specified.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
