{"id":"sh/1sfulsvq","kind":"textbox","name":"Title 1","position":{"left":88,"top":38.33,"width":1104,"height":139.17},"text":"Task 1 - Communication and trust","style":{"fontSize":58.67,"typeface":"Aptos Display","color":"#000000","alignment":"left"}},
{"id":"sh/0r6dc7el","kind":"textbox","name":"block-1-label","position":{"left":88,"top":190,"width":1104,"height":36},"text":"C1: assumptions","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/nuxcn2dw","kind":"textbox","name":"block-1-text","position":{"left":88,"top":230,"width":1104,"height":113},"text":"A1: there is no shared, authoritative backlog or decision log. A2: important release decisions are held in individual inboxes.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/mtovexwb","kind":"textbox","name":"block-2-label","position":{"left":88,"top":347,"width":1104,"height":36},"text":"C1: implications","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/9gfepcv2","kind":"textbox","name":"block-2-text","position":{"left":88,"top":387,"width":1104,"height":113},"text":"Teams may implement different priorities or lose context at handoffs. A shared backlog, named product owner and documented release decisions would reduce ambiguity.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/of6dg7eh","kind":"textbox","name":"block-3-label","position":{"left":88,"top":504,"width":1104,"height":36},"text":"C4: assumption and implication","style":{"fontSize":26.67,"typeface":"Aptos","color":"#C00000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/3ytcbids","kind":"textbox","name":"block-3-text","position":{"left":88,"top":544,"width":1104,"height":113},"text":"A3: Dev is rewarded for features and Ops for uptime. If true, conflicting incentives discourage risk reporting and sharing. Validate through interviews; introduce shared outcomes and no-blame reviews.","style":{"fontSize":28,"typeface":"Aptos","color":"#000000","alignment":"left"},"geometry":"rect","lineWidth":0},
{"id":"sh/ixkb2dw7","kind":"textbox","name":"page-number","position":{"left":1165,"top":693,"width":38,"height":22},"text":"05","style":{"fontSize":16,"typeface":"Aptos","color":"#7F7F7F","alignment":"left"},"geometry":"rect","lineWidth":0}
